        OpSet {
          Member [curr] {
            UOpAddr {
              Member [parser] {
                Identifier [core | -] {}
              }
            }
          }
          Call {
            Identifier [begin | -] {}
          }
        }
        OpSet {
          Member [source_id_base] {
            UOpAddr {
              Member [parser] {
                Identifier [core | -] {}
              }
            }
          }
          Call {
            Identifier [cast | -] {}
            Identifier [u32 | -] {}
            Identifier [source_id_base | -] {}
          }
        }
        OpSet {
          Member [token] {
            Member [peek] {
              UOpAddr {
                Member [parser] {
                  Identifier [core | -] {}
                }
              }
            }
          }
          Identifier [EMPTY | -] {}
        }
        OpSet {
          Member [is_std] {
            UOpAddr {
              Member [parser] {
                Identifier [core | -] {}
              }
            }
          }
          Identifier [is_std | -] {}
        }
        OpSet {
          Member [has_errors] {
            UOpAddr {
              Member [parser] {
                Identifier [core | -] {}
              }
            }
          }
          Identifier [False | -] {}
        }
        If {
          UOpLogNot {
            Call {
              Identifier [parse_file | -] {}
              Identifier [core | -] {}
            }
          }
          Return {
            Call {
              Identifier [none | -] {}
            }
          }
        }
        Definition [root] {
          Call {
            Identifier [complete_ast | -] {}
            Identifier [core | -] {}
          }
        }
        Return {
          Call {
            Identifier [some | -] {}
            Identifier [root | -] {}
          }
        }
      }
    }
  }
}

